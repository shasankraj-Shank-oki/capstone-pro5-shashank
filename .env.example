APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oms
DB_USER=
DB_PASSWORD=

DB_SSLMODE=prefer
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
LOG_LEVEL=info
ORDER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082

# Generate distinct secrets for your environment. Do not use this placeholder.
JWT_SECRET=
JWT_TTL=15m

ORDER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
PRODUCT_TIMEOUT=3s
PRODUCT_MAX_RETRIES=3
PRODUCT_RETRY_BASE_DELAY=300ms
PRODUCT_BREAKER_THRESHOLD=5
PRODUCT_BREAKER_RECOVERY=20s
SHUTDOWN_TIMEOUT=10s

# Comma-separated browser origins allowed to call the gateway. Empty = no CORS headers.
CORS_ALLOWED_ORIGINS=

# Login accounts for POST /auth/login (used to obtain JWTs). Leave a password
# empty to disable that account. Passwords need at least 12 characters.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=
AUTH_USER_USERNAME=user
AUTH_USER_PASSWORD=
